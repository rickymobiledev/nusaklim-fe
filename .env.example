# === Backend API (tim BE) — SERVER-ONLY ===
# JANGAN pakai prefix NEXT_PUBLIC_ di sini — nilai dengan prefix itu
# ke-bundle ke browser dan bocor ke publik. Base URL & API key harus
# tetap di server (lihat catatan di src/lib/api/fetcher.ts soal migrasi
# ke Route Handler/Server Action sebelum backend asli dipakai).
#
# API_BASE_URL = ORIGIN POLOS saja (TANPA "/api"), sama seperti {{BASE_URL}}
# di Postman collection tim BE — prefix "/api/v2" sudah otomatis ditambah
# di kode lewat API_V2_URL (src/constants/index.ts), jangan diulang di sini.
API_BASE_URL=http://localhost:8000
API_KEY=

# === NextAuth / Auth.js — SERVER-ONLY ===
# Generate dengan: npx auth secret   (atau: openssl rand -base64 32)
AUTH_SECRET=

# Wajib diisi ke URL asal Next.js di production (mis. https://cuaca.contoh.id)
# Tidak wajib untuk local dev.
# NEXTAUTH_URL=http://localhost:3000

# === Development helper — PUBLIC (bukan rahasia, boleh dibaca di client) ===
# Set "true" supaya semua hook data (useStations, useForecast, dst) memakai
# data mock dari src/lib/api/mock/, tanpa perlu backend menyala.
NEXT_PUBLIC_USE_MOCK_API=false
